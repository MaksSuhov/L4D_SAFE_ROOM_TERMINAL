# Copy to .env and fill in the OpenAI key.

APP_NAME=Left 4 Dead Interactive Safe-Room Terminal
DEBUG=false
API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://l4d:l4d@localhost:5432/l4d_terminal
DATABASE_ECHO=false
AUTO_CREATE_TABLES=false

OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
CHAT_TEMPERATURE=0.7
CHAT_MAX_TOKENS=600

RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.15
