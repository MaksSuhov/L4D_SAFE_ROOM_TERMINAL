# Copy to .env and fill in the credentials of your provider.

APP_NAME=Left 4 Dead Interactive Safe-Room Terminal
DEBUG=false
API_PREFIX=/api/v1

# Comma-separated list of browser origins allowed to call the API. The default
# already covers the Vite dev server of the bundled frontend.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgresql+asyncpg://l4d:l4d@localhost:5432/l4d_terminal
DATABASE_ECHO=false
AUTO_CREATE_TABLES=false

# --- AI provider ------------------------------------------------------------
# Any OpenAI-compatible endpoint works. The canonical names are AI_API_KEY and
# AI_BASE_URL; OPENAI_* and ROUTERAI_* are accepted as aliases, so an existing
# .env keeps working. Without a key the application refuses to start.
#
# Model ids are provider-specific: an aggregator such as RouterAI needs the
# vendor prefix (openai/text-embedding-3-small), while talking to OpenAI
# directly uses the bare id (text-embedding-3-small).

AI_API_KEY=sk-your-key-here
AI_BASE_URL=https://routerai.ru/api/v1

# RouterAI / Qwen
EMBEDDING_MODEL=openai/text-embedding-3-small
CHAT_MODEL=qwen/qwen3.7-flash

# OpenAI direct: leave AI_BASE_URL unset and use the bare model ids
# EMBEDDING_MODEL=text-embedding-3-small
# CHAT_MODEL=gpt-4o-mini

CHAT_TEMPERATURE=0.7
CHAT_MAX_TOKENS=600

# --- Retrieval --------------------------------------------------------------
# Retrieval is tiered: verified lore, wall graffiti and the answering
# character's own lines are looked up separately, each with its own budget, so a
# rumour can never crowd a fact out of the context.
RAG_OFFICIAL_TOP_K=4
RAG_GRAFFITI_TOP_K=3
RAG_VOICE_TOP_K=2

# Similarity floor for the evidence tiers. text-embedding-3-small rarely scores
# unrelated texts above 0.2, so this cuts the noise without cutting the matches.
RAG_MIN_SIMILARITY=0.25

# The character's own lines are a style reference rather than evidence, already
# narrowed to one speaker, so they are ranked but not gated.
RAG_VOICE_MIN_SIMILARITY=0.0

# --- HIDE: hypothetical expansion of the question ---------------------------
# A question may share no wording with the record that answers it: the player
# asks about a character while the record lives in the article of the campaign
# that character appears in. HIDE asks the model for hypothetical formulations
# (and one hypothetical article fragment) that bridge those entities, searches
# each of them and fuses the matches by similarity, so the tier budgets and
# floors keep their meaning. It costs one extra provider call before retrieval;
# turn it off when time to the first token matters more.
HIDE_ENABLED=true
HIDE_MAX_QUESTIONS=4

# --- Offline evaluation (make eval) -----------------------------------------
# The scoring stand only reports numbers that mean something if two runs of the
# same dataset are comparable, so generation there runs at a pinned temperature
# instead of the chat default above. A case whose answer comes back empty (the
# provider occasionally streams nothing, and the stand refuses to score an empty
# answer) is retried, and a case with no answer after every attempt is reported
# as a failure instead of being averaged in.
EVAL_TEMPERATURE=0.0
EVAL_ATTEMPTS=2

# --- Wiki corpus ------------------------------------------------------------
# The lore archive is extracted from the Russian branch of the Left 4 Dead
# Fandom wiki and stored as a JSONL snapshot; `python seed.py` ingests that
# snapshot, and `make corpus-refresh` regenerates it from the wiki. Pointing at
# the Russian wiki instead of the English one keeps the archive and the Russian
# questions in one language, which is what makes retrieval monolingual. The raw
# markup cache is disposable and not tracked by git.
WIKI_BASE_URL=https://left4dead.fandom.com/ru
WIKI_CACHE_DIR=data/wiki_cache/ru
CORPUS_PATH=data/corpus/lore.jsonl
INGESTION_BATCH_SIZE=64

# Language the corpus is normalised into by `seed.py --refresh --translate`.
# Off by default, and redundant while the corpus is already read in Russian.
CORPUS_LANGUAGE=ru

# --- Answer language --------------------------------------------------------
# Appended to every persona prompt, so the terminal always answers in Russian
# and keeps the whole dialogue in Russian regardless of the question language.
ANSWER_LANGUAGE_INSTRUCTION=Всегда отвечай только на русском языке, независимо от языка вопроса. Весь диалог, включая каждую реплику, веди на русском.

# --- Observability (Langfuse) -----------------------------------------------
# Optional tracing: with a key pair every chat turn becomes one trace with the
# retrieval step, the HIDE expansion and the model calls nested inside it. These
# are keys of a Langfuse project (cloud.langfuse.com or a self-hosted instance),
# not the provider keys above. Without a pair the terminal runs the no-op tracer
# and nothing leaves the process.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# false keeps the keys but runs the no-op tracer, e.g. to silence tracing in a
# local session without dropping the credentials.
LANGFUSE_ENABLED=true
