# Base URL of the FastAPI backend. Leave empty to send requests to the current
# origin and let the Vite dev proxy (see vite.config.js) forward /api, /docs and
# /openapi.json to :8000. Empty is the default, and it is what the cookie session
# wants: the browser then treats the API as its own host, exactly as in
# production. Pointing at http://localhost:8000 directly also works, but only
# while the page itself is served from the same site — a page on 127.0.0.1
# talking to localhost is a different site, and the browser would drop the
# session cookie.
VITE_API_BASE_URL=

# Prefix every route is mounted under on the backend (API_PREFIX in .env).
VITE_API_PREFIX=/api/v1

# Name of the CSRF cookie and of the header the client repeats it in. They must
# match AUTH_CSRF_COOKIE_NAME and AUTH_CSRF_HEADER_NAME in the backend .env:
# change them in one place only if you change them in the other.
VITE_CSRF_COOKIE_NAME=l4d_csrf
VITE_CSRF_HEADER_NAME=X-CSRF-Token
